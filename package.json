    "test": "npm run build && vitest run",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "electron": "^44.5.1",
    "typescript": "5.7",
    "vitest": "^2.1.9"
  }
}
