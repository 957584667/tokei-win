{
  "name": "tokei-win",
  "productName": "Tokei",
  "version": "0.1.0",
  "description": "Windows 托盘 AI 编程用量监控（Tokei 的 Windows 版）",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
